{
  "milestone": "M9",
  "model_name": "AquaPredict Screening Model ML Surrogate",
  "model_type": "HistGradientBoostingRegressor",
  "framework": "scikit-learn",
  "provenance_label": "SYNTHETIC SURROGATE",
